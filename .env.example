# WeatherVerse 3D Configuration
# By default, WeatherVerse 3D uses Open-Meteo High Resolution Weather & Air Quality API,
# which requires NO API KEY and works out of the box with 100% live data.

# (Optional) If you prefer using OpenWeatherMap, you can set your key here or in the application settings:
# VITE_OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Mode
VITE_APP_NAME="WeatherVerse 3D"
VITE_ENV=production
